      ],
      "group": 20,
      "role": "selling_point",
      "usable": true
    },
    {
      "id": 503,
      "start": 1038.08,
      "end": 1041.22,
      "text": "醋酸滅料的上身舒適感非常足現在就能穿",
      "members": [
        503
      ],
      "group": 21,
      "role": "selling_point",

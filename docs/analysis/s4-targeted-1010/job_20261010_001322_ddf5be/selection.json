  "selected_clauses": [
    {
      "id": 1,
      "start": 1.52,
      "end": 6.08,
      "text": "做丝绒这个品类里,我觉得我们做的是非常非常细的。",
      "members": [
        1
      ],
      "group": 0,
      "role": "hook",
      "usable": true
    },
    {
      "id": 3,
      "start": 8.72,
      "end": 10.7,
      "text": "以至于这么多年喜欢穿丝绒这个品类的女生,",
      "members": [
        3
      ],
      "group": 1,
      "role": "selling_point",
      "usable": true
    },
    {
      "id": 4,
      "start": 10.88,
      "end": 13.5,
      "text": "很多很多姐妹,只要买丝绒都会想到来泽泽家。",
      "members": [
        4
      ],
      "group": 1,
      "role": "selling_point",
      "usable": true
    },
    {
      "id": 5,
      "start": 13.64,
      "end": 15.26,
      "text": "只要你泽泽做,我不会去其他家买。",
      "members": [
        5
      ],
      "group": 1,
      "role": "selling_point",
      "usable": true
    },
    {
      "id": 29,
      "start": 61.83,
      "end": 63.57,
      "text": "这真真正正是品牌才做的东西",
      "members": [
        29
      ],
      "group": 1,
      "role": "selling_point",
      "usable": true
    },
    {
      "id": 51,
      "start": 114.02,
      "end": 116.34,
      "text": "因为你只有在品牌你才会买到这种细节的东西",
      "members": [
        51,

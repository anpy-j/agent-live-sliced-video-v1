      "group": 14,
      "role": "styling",
      "usable": true
    },
    {
      "id": 390,
      "start": 783.46,
      "end": 787.72,
      "text": "包括你修店的时候里面搭个小毛衣穿一个小高领的感觉都很好看",
      "members": [
        390,
        391
      ],
      "group": 15,
      "role": "styling",
      "usable": true
    },
    {
      "id": 398,
      "start": 801.68,
      "end": 803.38,
      "text": "很好看对吧你就搭裙子穿",
      "members": [
